# Only needed for running the assistant on your own computer.
# Copy this file to ".env" and fill in the values. Never share or commit .env.
# On Vercel, the same names are used as Environment Variables.

# Your university's Canvas address, without a trailing slash.
CANVAS_BASE_URL=https://canvas.youruni.edu

# Canvas -> Account -> Settings -> "+ New Access Token"
CANVAS_TOKEN=

# Gemini key from aistudio.google.com/apikey
GEMINI_API_KEY=

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# The value from the connect page (https://canvas-calendar-assistant.vercel.app/connect.html).
# Leave empty if you sign in with: python -m assistant.connect_google
GOOGLE_TOKEN_JSON=

# Filled in automatically by: python -m assistant.connect_google
GOOGLE_CALENDAR_ID=

# A long random password. Only used when hosted: it keeps strangers from starting your
# copy's Canvas check. The connect page makes one for you.
CRON_SECRET=

# --- optional ---

TIMEZONE=Africa/Cairo

# The day you created the Canvas token, like 2026-11-11, for the renewal reminder.
# If empty, the assistant counts from the day it first used the token.
CANVAS_TOKEN_CREATED=

# How many days back to look for announcements and messages.
LOOKBACK_DAYS=21

# Your Telegram chat's number. Normally not needed: the first person to message the bot
# becomes its owner. If you set it, only that chat is ever used, and the assistant can also
# warn you there when its Google sign-in stops working.
TELEGRAM_CHAT_ID=

# Hour of the morning overview (0-23). Write "off" to disable it.
DIGEST_HOUR=7

# Gemini models to try, best first. Each has its own small free daily quota.
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
