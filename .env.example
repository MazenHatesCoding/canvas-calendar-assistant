# Copy this file to ".env" and fill in the values. Never share or commit .env.
# On Vercel, the same names are used as Environment Variables.

# Your university's Canvas address, without a trailing slash.
CANVAS_BASE_URL=https://canvas.youruni.edu

# Canvas -> Account -> Settings -> "+ New Access Token"
CANVAS_TOKEN=

# The day you created that token, like 2026-11-11. Used for the renewal reminder.
CANVAS_TOKEN_CREATED=

# Gemini key from aistudio.google.com -> "Get API key"
GEMINI_API_KEY=

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Filled in automatically by: python -m assistant.connect_google
GOOGLE_CALENDAR_ID=

# Two long random strings you make up. Only needed when hosted on Vercel: they keep
# strangers from calling your copy's web addresses.
CRON_SECRET=
TELEGRAM_WEBHOOK_SECRET=

# --- optional ---

TIMEZONE=Africa/Cairo

# How many days back to look for announcements and messages.
LOOKBACK_DAYS=21

# Hour of the morning overview (0-23). Write "off" to disable it.
DIGEST_HOUR=7

# Gemini models to try, best first. Each has its own small free daily quota.
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
