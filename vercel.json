{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/check.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,public/**,.github/**,.venv/**}"
    },
    "api/telegram.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,public/**,.github/**,.venv/**}"
    }
  },
  "schedules": {
    "hourly-check": {
      "schedule": "7 * * * *",
      "path": "/api/check",
      "requestMethod": "GET"
    }
  }
}
